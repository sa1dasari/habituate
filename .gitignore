# Node
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/.turbo/

# Java / Maven
api/target/
api/.mvn/wrapper/*.jar
api/.mvn/wrapper/maven-wrapper.properties

# Docker
*.log

# Editor
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Firebase — service account key is a secret, never commit it
*service-account*.json
*firebase-adminsdk*.json
*adminsdk*.json

# Backend secrets (Anthropic API key, etc.) — local-only override, never commit it
api/src/main/resources/application-secrets.properties

# Mobile env (contains API keys)
mobile/.env.local
mobile/.env

# google-services.json is intentionally tracked (mobile/google-services.json) —
# EAS Build's archive step excludes gitignored files even when force-added, and
# the native Google Sign-In config plugin needs this file present to build.
# Content is public client identifiers (API key, OAuth client IDs), same
# category already committed in mobile/firebase.js — not secrets; Firebase's
# security model is Security Rules + server-side token verification.
GoogleService-Info.plist
