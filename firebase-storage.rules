rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photo: exactly one file per user, named {uid}.jpg, matches
    // EditProfileModal.js's upload path. Public read since it's shown to
    // other users (groupmates, friends, activity feed).
    match /profile-photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Feedback attachments: any number of files under the user's own uid
    // folder, variable filename ({timestamp}-{name}), matches
    // uploadAttachment.js's path. Not publicly readable — the only intended
    // reader is the maintainer via the emailed download-URL (which carries
    // its own access token and works independent of these rules), so read
    // access here is just "owner can see their own", not "anyone with a link".
    match /feedback-attachments/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024;
    }

  }
}
